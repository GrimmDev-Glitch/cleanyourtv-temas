tools/venv
tools/adbkey/
__pycache__/
launcher/.gradle/
launcher/build/
launcher/app/build/
launcher/local.properties
# your own TV's dumps (serial, android_id, device names) stay local
backup/
# session screenshots and working notes (may show the Wi-Fi name or account avatar) stay local
shots/
work/
# Perfetto traces from tools/trace.py: large, and they hold the TV's process list
traces/
# Results from tools/bench.py: result.json carries the address the run was given and the TV's fingerprint.
bench-results/
.DS_Store

# Generated install bundles and JVM crash reports stay out of contributions.
*.apk
*.aab
launcher/hs_err_pid*.log
launcher/replay_pid*.log

# ---- CleanYourTV Temas -------------------------------------------------------------------------------
# Your own files: backup, screenshots, notes with your IP and Wi-Fi names, restore lists. Never uploaded.
privado/
# Personal themes (themes/mi-*): your video, your sounds, your apps. Never uploaded.
themes/mi-*/
# Videos and sounds inside any theme: everyone puts their own (copyright). The folders' README says where.
themes/*/wallpaper.mp4
themes/*/sounds/
*.mp4
*.mp3
# Build tools downloaded by tools/preparar-herramientas.ps1 (next to the repo, but just in case)
toolchain/

<?xml version="1.0" encoding="utf-8"?>
<!-- The UI fonts, looked up through these strings so a locale can swap in a system family: Outfit has no
     glyphs for most Vietnamese accented letters, so values-vi points them at the system sans-serif (#833). -->
<!-- Edgerunners skin: Rajdhani (SIL OFL 1.1, Indian Type Foundry) in place of Outfit, one or two weights heavier than the design for a bolder look. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">@font/rajdhani_medium</string>
    <string name="font_regular" translatable="false">@font/rajdhani_medium</string>
    <string name="font_light" translatable="false">@font/rajdhani_medium</string>
    <string name="font_extralight" translatable="false">@font/rajdhani_medium</string>
    <string name="font_medium" translatable="false">@font/rajdhani_semibold</string>
</resources>

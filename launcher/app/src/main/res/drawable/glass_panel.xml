<?xml version="1.0" encoding="utf-8"?>
<!-- Edgerunners skin: the dropdown menus as a Cyberpunk panel - dark teal with a cyan edge and a neon yellow bar
     down the left side. The original glass is in work\orig-res\drawable_glass_panel.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF061A20" />
            <stroke android:width="1dp" android:color="#9900F0FF" />
            <corners android:radius="2dp" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start|fill_vertical">
        <shape android:shape="rectangle">
            <solid android:color="#FFFCEE0A" />
        </shape>
    </item>
</layer-list>
